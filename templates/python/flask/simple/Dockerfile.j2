FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml README.md ./
COPY src ./src
{% if migrations %}
COPY alembic.ini ./
COPY migrations ./migrations
{% endif %}

RUN uv sync --no-dev

ENV PATH="/app/.venv/bin:$PATH"
ENV FLASK_APP={{ package_name }}:create_app

EXPOSE 8000

CMD ["flask", "--app", "{{ package_name }}:create_app", "run", "--host", "0.0.0.0", "--port", "8000"]
