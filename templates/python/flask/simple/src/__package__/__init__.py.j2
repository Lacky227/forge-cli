"""{{ project_name }} — generated Flask application."""

from __future__ import annotations

from dotenv import load_dotenv
from flask import Flask

from {{ package_name }}.config import Config


def create_app(config_object: type[Config] | None = None) -> Flask:
    """Application factory."""
    load_dotenv()
    app = Flask(__name__)
    app.config.from_object(config_object or Config)

{% if is_mongodb %}
    from {{ package_name }}.mongodb import init_mongodb

    init_mongodb(app)
{% endif %}
{% if is_redis %}
    from {{ package_name }}.redis_client import init_redis

    init_redis(app)
{% endif %}

    from {{ package_name }}.routes import bp

    app.register_blueprint(bp)
{% for b in flask_blueprints|sort(attribute='module_id') %}
    from {{ b.import_module }} import (
        {{ b.blueprint_attr }} as {{ b.module_id }}_bp,
    )

    app.register_blueprint({{ b.module_id }}_bp)
{% endfor %}

    return app
