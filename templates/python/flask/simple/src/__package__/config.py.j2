from __future__ import annotations

import os

from dotenv import load_dotenv

load_dotenv()


class Config:
    """Flask configuration loaded from environment variables."""

    APP_NAME: str = os.getenv("APP_NAME", "{{ project_name }}")
{% if database %}
    DATABASE_URL: str = os.getenv(
        "DATABASE_URL",
        "{{ database_url_example }}",
    )
{% endif %}
{% if is_mongodb %}
    MONGODB_URL: str = os.getenv(
        "MONGODB_URL",
        "{{ mongodb_url_example }}",
    )
    MONGODB_DATABASE: str = os.getenv(
        "MONGODB_DATABASE",
        "{{ mongodb_database_example }}",
    )
{% endif %}
{% if is_redis %}
    REDIS_URL: str = os.getenv(
        "REDIS_URL",
        "{{ redis_url_example }}",
    )
{% endif %}
