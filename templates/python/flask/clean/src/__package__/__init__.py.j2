"""{{ project_name }} — Clean Architecture Flask application."""

from __future__ import annotations

from dotenv import load_dotenv
from flask import Flask

from {{ package_name }}.infrastructure.config import Config


def create_app(config_object: type[Config] | None = None) -> Flask:
    """Application factory wiring presentation to application use cases."""
    load_dotenv()
    app = Flask(__name__)
    app.config.from_object(config_object or Config)

    from {{ package_name }}.presentation.api import bp

    app.register_blueprint(bp)
    return app
