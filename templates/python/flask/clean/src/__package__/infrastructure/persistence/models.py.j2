"""SQLAlchemy declarative base and model registry.

``Base`` lives in ``base`` so module model modules can import it without
circular imports. This package re-exports ``Base`` and imports selected
module models so Alembic metadata stays complete.
"""

# isort: off
{% for m in model_imports|sort(attribute='module_id') %}
from {{ m.import_module }} import (  # noqa: F401
    {{ m.symbol }} as _{{ m.module_id }}_model,
)
{% endfor %}
from {{ package_name }}.infrastructure.persistence.base import Base
# isort: on

__all__ = ["Base"]
