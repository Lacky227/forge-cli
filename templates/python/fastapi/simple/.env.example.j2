{% if database %}
DATABASE_URL={{ database_url_example }}
{% endif %}
{% if is_mongodb %}
MONGODB_URL={{ mongodb_url_example }}
MONGODB_DATABASE={{ mongodb_database_example }}
{% endif %}
{% if is_redis %}
REDIS_URL={{ redis_url_example }}
{% endif %}
{% if docker and is_postgresql %}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB={{ package_name }}
{% endif %}
