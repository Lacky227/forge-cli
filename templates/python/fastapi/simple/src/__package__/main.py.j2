{% if is_mongodb or is_redis %}
from contextlib import asynccontextmanager

{% endif %}
from fastapi import FastAPI

from {{ package_name }}.config import settings
{% for router in fastapi_routers|sort(attribute='module_id') %}
from {{ router.import_module }} import (
    {{ router.router_attr }} as {{ router.module_id }}_router,
)
{% endfor %}

{% if is_mongodb or is_redis %}

@asynccontextmanager
async def lifespan(app: FastAPI):
{% if is_mongodb %}
    from {{ package_name }}.mongodb import create_mongodb_client, get_database

    mongo_client = create_mongodb_client()
    app.state.mongodb = mongo_client
    app.state.mongodb_db = get_database(mongo_client)
{% endif %}
{% if is_redis %}
    from {{ package_name }}.redis_client import create_redis_client

    app.state.redis = create_redis_client()
{% endif %}
    yield
{% if is_mongodb %}
    await app.state.mongodb.close()
{% endif %}
{% if is_redis %}
    await app.state.redis.aclose()
{% endif %}


app = FastAPI(title=settings.app_name, lifespan=lifespan)
{% else %}
app = FastAPI(title=settings.app_name)
{% endif %}


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok"}
{% for router in fastapi_routers|sort(attribute='module_id') %}


app.include_router(
    {{ router.module_id }}_router,
    prefix="{{ router.prefix }}",
    tags={{ router.tags }},
)
{% endfor %}
