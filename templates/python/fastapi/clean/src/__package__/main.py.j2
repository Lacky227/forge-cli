{% if is_mongodb or is_redis %}
from contextlib import asynccontextmanager

{% endif %}
from fastapi import FastAPI

from {{ package_name }}.infrastructure.config import settings
from {{ package_name }}.presentation.api import router
{% for r in fastapi_routers|sort(attribute='module_id') %}
from {{ r.import_module }} import (
    {{ r.router_attr }} as {{ r.module_id }}_router,
)
{% endfor %}

{% if is_mongodb or is_redis %}

@asynccontextmanager
async def lifespan(app: FastAPI):
{% if is_mongodb %}
    from {{ package_name }}.infrastructure.mongodb import (
        create_mongodb_client,
        get_database,
    )

    mongo_client = create_mongodb_client()
    app.state.mongodb = mongo_client
    app.state.mongodb_db = get_database(mongo_client)
{% endif %}
{% if is_redis %}
    from {{ package_name }}.infrastructure.redis_client import create_redis_client

    app.state.redis = create_redis_client()
{% endif %}
    yield
{% if is_mongodb %}
    await app.state.mongodb.close()
{% endif %}
{% if is_redis %}
    await app.state.redis.aclose()
{% endif %}


app = FastAPI(title=settings.app_name, lifespan=lifespan)
{% else %}
app = FastAPI(title=settings.app_name)
{% endif %}
app.include_router(router)
{% for r in fastapi_routers|sort(attribute='module_id') %}
app.include_router(
    {{ r.module_id }}_router,
    prefix="{{ r.prefix }}",
    tags={{ r.tags }},
)
{% endfor %}
