{% if is_mongodb or is_redis_nosql %}
from contextlib import asynccontextmanager

{% endif %}
from fastapi import FastAPI

from {{ package_name }}.api.routes import api_router
from {{ package_name }}.core.config import settings
{% if has_authentication %}
from {{ package_name }}.security.hardening import install_security
{% endif %}

{% if is_mongodb or is_redis_nosql %}

@asynccontextmanager
async def lifespan(app: FastAPI):
{% if is_mongodb %}
    from {{ package_name }}.core.mongodb import create_mongodb_client, get_database

    mongo_client = create_mongodb_client()
    app.state.mongodb = mongo_client
    app.state.mongodb_db = get_database(mongo_client)
{% endif %}
{% if is_redis_nosql %}
    from {{ package_name }}.core.redis_client import create_redis_client

    app.state.redis = create_redis_client()
{% endif %}
    yield
{% if is_mongodb %}
    await app.state.mongodb.close()
{% endif %}
{% if is_redis_nosql %}
    await app.state.redis.aclose()
{% endif %}


app = FastAPI(title=settings.app_name, lifespan=lifespan)
{% else %}
app = FastAPI(title=settings.app_name)
{% endif %}
{% if has_authentication %}
install_security(app)
{% endif %}
app.include_router(api_router)
