"""Idempotent cleanup for expired authentication state (SQLAlchemy).

Scheduling is the deployment's responsibility — run periodically via cron,
systemd timer, or an orchestrator job.
"""

from __future__ import annotations

from datetime import datetime, timezone

from sqlalchemy import delete
from sqlalchemy.orm import Session

from {{ auth_models_import }} import AuthSession
{% if authentication_email_verification or authentication_password_reset %}
from {{ auth_models_import }} import AuthActionToken
{% endif %}


def cleanup_auth_state(db: Session, *, now: datetime | None = None) -> dict[str, int]:
    """Delete expired action tokens and refresh sessions past family expiry.

    Replaced/revoked sessions that are still within the family ``expires_at``
    window are retained so refresh replay detection continues to work.
    Consumed action tokens are removed only once past ``expires_at``.
    """
    moment = now or datetime.now(timezone.utc)
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)

{% if authentication_email_verification or authentication_password_reset %}
    # Avoid ORM synchronize comparing naive/aware datetimes on SQLite.
    tokens_deleted = db.execute(
        delete(AuthActionToken).where(AuthActionToken.expires_at <= moment),
        execution_options={"synchronize_session": False},
    ).rowcount or 0
{% else %}
    tokens_deleted = 0
{% endif %}
    sessions_deleted = db.execute(
        delete(AuthSession).where(AuthSession.expires_at <= moment),
        execution_options={"synchronize_session": False},
    ).rowcount or 0
    db.commit()
    return {"action_tokens": int(tokens_deleted), "sessions": int(sessions_deleted)}


def main() -> None:
{% if auth_cleanup_flask | default(false) %}
    from {{ auth_app_factory_import }} import create_app
    from {{ auth_database_import }} import get_session

    app = create_app()
    with app.app_context():
        generator = get_session()
        db = next(generator)
        try:
            result = cleanup_auth_state(db)
        finally:
            generator.close()
{% else %}
    from {{ auth_database_import }} import SessionLocal

    db = SessionLocal()
    try:
        result = cleanup_auth_state(db)
    finally:
        db.close()
{% endif %}
    print(
        "cleanup_auth_state: removed "
        f"{result['action_tokens']} action tokens, "
        f"{result['sessions']} sessions"
    )


if __name__ == "__main__":
    main()
