from __future__ import annotations

{% if authentication_email_verification or authentication_password_reset %}
import os
{% endif %}
from typing import Annotated

from fastapi import Depends, HTTPException, Request, Response, status
from fastapi.routing import APIRouter
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
from pydantic import BaseModel, EmailStr, Field
from sqlalchemy.orm import Session

from {{ auth_database_import }} import get_db
from {{ auth_models_import }} import User
from {{ auth_rate_limit_import }} import check_rate_limit
from {{ auth_service_import }} import (
    AuthFailure, DuplicateIdentity, authenticate_user, change_password,
    create_session, issue_access_token, register_user, resolve_user,
    revoke_all, revoke_refresh, rotate_session,
)
{% if authentication_email_verification %}
from {{ auth_service_import }} import VERIFY_EMAIL, confirm_email_token
{% endif %}
{% if authentication_password_reset %}
from {{ auth_service_import }} import RESET_PASSWORD, reset_password_with_token
{% endif %}
{% if authentication_email_verification or authentication_password_reset %}
from {{ auth_service_import }} import issue_action_token
from {{ auth_delivery_import }} import {{ auth_delivery_symbol|default("deliver_security_email") }} as deliver_security_email
{% endif %}

router = APIRouter()
bearer = HTTPBearer(auto_error=False)


class RegistrationInput(BaseModel):
    email: EmailStr
    password: str = Field(min_length=1, max_length=128)
    display_name: str | None = Field(default=None, max_length=120)


class LoginInput(BaseModel):
    email: EmailStr
    password: str = Field(min_length=1, max_length=128)


class RefreshInput(BaseModel):
    refresh_token: str = Field(min_length=20, max_length=512)


class PasswordChangeInput(BaseModel):
    current_password: str = Field(min_length=1, max_length=128)
    new_password: str = Field(min_length=1, max_length=128)

{% if authentication_email_verification or authentication_password_reset %}
class EmailActionInput(BaseModel):
    email: EmailStr


class ActionTokenInput(BaseModel):
    token: str = Field(min_length=20, max_length=512)
{% endif %}
{% if authentication_password_reset %}
class PasswordResetInput(ActionTokenInput):
    new_password: str = Field(min_length=1, max_length=128)
{% endif %}


def public_user(user: User) -> dict[str, object]:
    return {"id": str(user.id), "email": user.email, "display_name": user.display_name, "is_active": user.is_active, "is_verified": user.is_verified, "created_at": user.created_at}


def token_response(user: User, raw: str, session_id: str, response: Response) -> dict[str, object]:
    response.headers["Cache-Control"] = "no-store"
    return {"access_token": issue_access_token(user, session_id), "refresh_token": raw, "token_type": "bearer", "expires_in": 900}


def auth_error(exc: Exception) -> HTTPException:
    return HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=str(exc), headers={"WWW-Authenticate": "Bearer"})


def _client_ip(request: Request) -> str:
    return request.client.host if request.client is not None else "unknown"


def enforce_rate_limit(category: str):
    def dependency(request: Request) -> None:
        decision = check_rate_limit(category, _client_ip(request))
        if not decision.allowed:
            raise HTTPException(
                status_code=status.HTTP_429_TOO_MANY_REQUESTS,
                detail="too many requests",
                headers={"Retry-After": str(decision.retry_after)},
            )

    return dependency


def get_current_user(credentials: Annotated[HTTPAuthorizationCredentials | None, Depends(bearer)], db: Annotated[Session, Depends(get_db)]) -> User:
    if credentials is None:
        raise auth_error(AuthFailure("authentication required"))
    try:
        return resolve_user(db, credentials.credentials)
    except AuthFailure as exc:
        raise auth_error(exc) from exc

{% if authentication_registration %}
@router.post("/register", status_code=201, dependencies=[Depends(enforce_rate_limit("registration"))])
def register(payload: RegistrationInput, db: Annotated[Session, Depends(get_db)]) -> dict[str, object]:
    try:
        user = register_user(db, str(payload.email), payload.password, payload.display_name)
{% if authentication_email_verification %}
        raw = issue_action_token(db, user, VERIFY_EMAIL, int(os.environ.get("AUTH_VERIFICATION_TOKEN_TTL_SECONDS", "86400")))
        try:
            deliver_security_email(user.email, VERIFY_EMAIL, raw)
        except Exception as exc:
            raise HTTPException(status_code=503, detail="verification delivery unavailable; request a new message") from exc
{% endif %}
        return public_user(user)
    except DuplicateIdentity as exc:
        raise HTTPException(status_code=409, detail="identity already exists") from exc
    except AuthFailure as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc

{% endif %}
@router.post("/login", dependencies=[Depends(enforce_rate_limit("credential"))])
def login(payload: LoginInput, response: Response, db: Annotated[Session, Depends(get_db)]) -> dict[str, object]:
    try:
        user = authenticate_user(db, str(payload.email), payload.password)
        raw, session = create_session(db, user)
        return token_response(user, raw, session.id, response)
    except AuthFailure as exc:
        raise auth_error(exc) from exc


@router.post("/refresh", dependencies=[Depends(enforce_rate_limit("refresh"))])
def refresh(payload: RefreshInput, response: Response, db: Annotated[Session, Depends(get_db)]) -> dict[str, object]:
    try:
        user, raw, session = rotate_session(db, payload.refresh_token)
        return token_response(user, raw, session.id, response)
    except AuthFailure as exc:
        raise auth_error(exc) from exc


@router.post("/logout", status_code=204)
def logout(payload: RefreshInput, db: Annotated[Session, Depends(get_db)]) -> Response:
    revoke_refresh(db, payload.refresh_token)
    return Response(status_code=204)


@router.get("/me")
def me(user: Annotated[User, Depends(get_current_user)]) -> dict[str, object]:
    return public_user(user)


@router.post("/logout-all", status_code=204)
def logout_all(user: Annotated[User, Depends(get_current_user)], db: Annotated[Session, Depends(get_db)]) -> Response:
    revoke_all(db, user)
    return Response(status_code=204)


@router.post("/password/change", status_code=204)
def password_change(payload: PasswordChangeInput, user: Annotated[User, Depends(get_current_user)], db: Annotated[Session, Depends(get_db)]) -> Response:
    try:
        change_password(db, user, payload.current_password, payload.new_password)
    except AuthFailure as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    return Response(status_code=204)

{% if authentication_email_verification %}
@router.post("/email-verification/request", status_code=202, dependencies=[Depends(enforce_rate_limit("recovery"))])
def request_email_verification(payload: EmailActionInput, db: Annotated[Session, Depends(get_db)]) -> dict[str, str]:
    user = db.query(User).filter(User.canonical_email == str(payload.email).strip().casefold()).first()
    if user is not None and user.is_active and not user.is_verified:
        raw = issue_action_token(db, user, VERIFY_EMAIL, int(os.environ.get("AUTH_VERIFICATION_TOKEN_TTL_SECONDS", "86400")))
        try:
            deliver_security_email(user.email, VERIFY_EMAIL, raw)
        except Exception:
            pass
    return {"detail": "if the account is eligible, a message will be sent"}


@router.post("/email-verification/confirm", status_code=204)
def confirm_email_verification(payload: ActionTokenInput, db: Annotated[Session, Depends(get_db)]) -> Response:
    try:
        confirm_email_token(db, payload.token)
    except AuthFailure as exc:
        raise HTTPException(status_code=400, detail="invalid or expired action token") from exc
    return Response(status_code=204)
{% endif %}

{% if authentication_password_reset %}
@router.post("/password/forgot", status_code=202, dependencies=[Depends(enforce_rate_limit("recovery"))])
def forgot_password(payload: EmailActionInput, db: Annotated[Session, Depends(get_db)]) -> dict[str, str]:
    user = db.query(User).filter(User.canonical_email == str(payload.email).strip().casefold()).first()
    if user is not None and user.is_active:
        raw = issue_action_token(db, user, RESET_PASSWORD, int(os.environ.get("AUTH_RESET_TOKEN_TTL_SECONDS", "1800")))
        try:
            deliver_security_email(user.email, RESET_PASSWORD, raw)
        except Exception:
            pass
    return {"detail": "if the account is eligible, a message will be sent"}


@router.post("/password/reset", status_code=204)
def reset_password(payload: PasswordResetInput, db: Annotated[Session, Depends(get_db)]) -> Response:
    try:
        reset_password_with_token(db, payload.token, payload.new_password)
    except AuthFailure as exc:
        raise HTTPException(status_code=400, detail="invalid or expired action token") from exc
    return Response(status_code=204)
{% endif %}
