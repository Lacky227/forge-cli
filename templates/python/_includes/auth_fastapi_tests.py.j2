from __future__ import annotations


EMAIL = "person@example.com"
PASSWORD = "correct horse battery staple"
NEW_PASSWORD = "new correct horse battery staple"


def _register(client):
    return client.post("/auth/register", json={"email": EMAIL, "password": PASSWORD, "display_name": "Person"})


{% if authentication_registration and not authentication_email_verification %}
def test_authentication_lifecycle_and_refresh_replay(client):
    registered = _register(client)
    assert registered.status_code == 201
    assert "password_hash" not in registered.json()
    assert _register(client).status_code == 409

    assert client.post("/auth/login", json={"email": EMAIL, "password": "wrong password value"}).status_code == 401
    assert client.post("/auth/login", json={"email": "unknown@example.com", "password": PASSWORD}).status_code == 401
    login = client.post("/auth/login", json={"email": EMAIL.upper(), "password": PASSWORD})
    assert login.status_code == 200
    assert login.headers["cache-control"] == "no-store"
    tokens = login.json()
    headers = {"Authorization": f"Bearer {tokens['access_token']}"}
    assert client.get("/auth/me").status_code == 401
    assert client.get("/auth/me", headers=headers).json()["email"] == EMAIL
    assert client.get("/auth/me", headers={"Authorization": "Bearer malformed"}).status_code == 401

    rotated = client.post("/auth/refresh", json={"refresh_token": tokens["refresh_token"]})
    assert rotated.status_code == 200
    assert rotated.json()["refresh_token"] != tokens["refresh_token"]
    replay = client.post("/auth/refresh", json={"refresh_token": tokens["refresh_token"]})
    assert replay.status_code == 401
    assert client.post("/auth/refresh", json={"refresh_token": rotated.json()["refresh_token"]}).status_code == 401


def test_password_change_invalidates_access_and_sessions(client):
    _register(client)
    first = client.post("/auth/login", json={"email": EMAIL, "password": PASSWORD}).json()
    second = client.post("/auth/login", json={"email": EMAIL, "password": PASSWORD}).json()
    headers = {"Authorization": f"Bearer {first['access_token']}"}
    changed = client.post("/auth/password/change", headers=headers, json={"current_password": PASSWORD, "new_password": NEW_PASSWORD})
    assert changed.status_code == 204
    assert client.get("/auth/me", headers=headers).status_code == 401
    assert client.post("/auth/refresh", json={"refresh_token": second["refresh_token"]}).status_code == 401
    assert client.post("/auth/login", json={"email": EMAIL, "password": PASSWORD}).status_code == 401
    assert client.post("/auth/login", json={"email": EMAIL, "password": NEW_PASSWORD}).status_code == 200
{% elif not authentication_registration %}
def test_registration_is_not_exposed(client):
    assert _register(client).status_code == 404
{% endif %}
