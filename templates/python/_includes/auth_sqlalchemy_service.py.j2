"""Authentication primitives and transactional SQLAlchemy service functions."""

from __future__ import annotations

import hashlib
import os
import secrets
import uuid
from datetime import datetime, timedelta, timezone

import jwt
from dotenv import load_dotenv
from pwdlib import PasswordHash
from sqlalchemy import select, text, update
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from {{ auth_models_import }} import AuthSession, User

load_dotenv()

JWT_ALGORITHM = "HS256"
PASSWORD_MIN_LENGTH = 15
PASSWORD_MAX_CHARS = 128
PASSWORD_MAX_BYTES = 1024
_password_hash = PasswordHash.recommended()
_dummy_hash = _password_hash.hash("forge-dummy-password-only-for-timing")


class AuthFailure(Exception):
    pass


class DuplicateIdentity(AuthFailure):
    pass


def _setting(name: str, default: str = "") -> str:
    return os.getenv(name, default)


def validate_runtime_secret() -> str:
    value = _setting("AUTH_JWT_SECRET")
    placeholders = {"", "changeme", "change-me", "dev-insecure-change-me"}
    if _setting("APP_ENV", "development").lower() == "production" and value.strip().lower() in placeholders:
        raise RuntimeError("AUTH_JWT_SECRET must be a strong, non-placeholder value in production")
    if not value:
        raise RuntimeError("AUTH_JWT_SECRET is required; copy .env.example or use the generated .env")
    return value


_JWT_SECRET = validate_runtime_secret()


def canonicalize_email(email: str) -> str:
    return email.strip().casefold()


def validate_password(password: str) -> None:
    if len(password) < PASSWORD_MIN_LENGTH:
        raise AuthFailure(f"password must be at least {PASSWORD_MIN_LENGTH} characters")
    if len(password) > PASSWORD_MAX_CHARS or len(password.encode("utf-8")) > PASSWORD_MAX_BYTES:
        raise AuthFailure("password is too long")


def hash_password(password: str) -> str:
    validate_password(password)
    return _password_hash.hash(password)


def verify_password(password: str, encoded: str) -> tuple[bool, str | None]:
    valid, updated = _password_hash.verify_and_update(password, encoded)
    return valid, updated


def digest_refresh_token(raw: str) -> str:
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def issue_access_token(user: User, session_id: str) -> str:
    now = datetime.now(timezone.utc)
    claims = {
        "iss": _setting("AUTH_ISSUER", "{{ package_name }}"),
        "aud": _setting("AUTH_AUDIENCE", "{{ package_name }}-api"),
        "sub": str(user.id),
        "sid": session_id,
        "ver": user.auth_version,
        "jti": str(uuid.uuid4()),
        "iat": now,
        "nbf": now,
        "exp": now + timedelta(seconds=int(_setting("AUTH_ACCESS_TOKEN_TTL_SECONDS", "900"))),
        "typ": "access",
    }
    return jwt.encode(claims, _JWT_SECRET, algorithm=JWT_ALGORITHM)


def decode_access_token(token: str) -> dict[str, object]:
    try:
        claims = jwt.decode(
            token,
            _JWT_SECRET,
            algorithms=[JWT_ALGORITHM],
            audience=_setting("AUTH_AUDIENCE", "{{ package_name }}-api"),
            issuer=_setting("AUTH_ISSUER", "{{ package_name }}"),
            options={"require": ["iss", "aud", "sub", "sid", "ver", "jti", "iat", "nbf", "exp", "typ"]},
        )
    except jwt.PyJWTError as exc:
        raise AuthFailure("invalid authentication credentials") from exc
    if claims.get("typ") != "access":
        raise AuthFailure("invalid authentication credentials")
    return claims


def register_user(db: Session, email: str, password: str, display_name: str | None) -> User:
    user = User(email=email.strip(), canonical_email=canonicalize_email(email), display_name=display_name, password_hash=hash_password(password))
    db.add(user)
    try:
        db.commit()
    except IntegrityError as exc:
        db.rollback()
        raise DuplicateIdentity("identity already exists") from exc
    db.refresh(user)
    return user


def authenticate_user(db: Session, email: str, password: str) -> User:
    user = db.scalar(select(User).where(User.canonical_email == canonicalize_email(email)))
    if user is None:
        _password_hash.verify(password, _dummy_hash)
        raise AuthFailure("invalid email or password")
    valid, updated_hash = verify_password(password, user.password_hash)
    if not valid or not user.is_active:
        raise AuthFailure("invalid email or password")
    if updated_hash:
        user.password_hash = updated_hash
    user.last_login_at = datetime.now(timezone.utc)
    db.commit()
    db.refresh(user)
    return user


def create_session(db: Session, user: User) -> tuple[str, AuthSession]:
    raw = secrets.token_urlsafe(32)
    now = datetime.now(timezone.utc)
    session = AuthSession(user_id=user.id, family_id=str(uuid.uuid4()), token_digest=digest_refresh_token(raw), expires_at=now + timedelta(days=int(_setting("AUTH_REFRESH_TOKEN_TTL_DAYS", "30"))))
    db.add(session)
    db.commit()
    db.refresh(session)
    return raw, session


def rotate_session(db: Session, raw: str) -> tuple[User, str, AuthSession]:
    now = datetime.now(timezone.utc)
    # PostgreSQL uses the row lock below. SQLite ignores FOR UPDATE, so acquire
    # its strongest practical write reservation before reading the old token.
    if db.bind is not None and db.bind.dialect.name == "sqlite":
        db.execute(text("BEGIN IMMEDIATE"))
    old = db.scalar(select(AuthSession).where(AuthSession.token_digest == digest_refresh_token(raw)).with_for_update())
    if old is None:
        raise AuthFailure("invalid refresh token")
    if old.replaced_by_id is not None:
        db.execute(update(AuthSession).where(AuthSession.family_id == old.family_id, AuthSession.revoked_at.is_(None)).values(revoked_at=now))
        db.commit()
        raise AuthFailure("refresh token replay detected")
    if old.revoked_at is not None or _aware(old.expires_at) <= now:
        raise AuthFailure("invalid refresh token")
    user = db.get(User, old.user_id)
    if user is None or not user.is_active:
        raise AuthFailure("invalid refresh token")
    new_raw = secrets.token_urlsafe(32)
    replacement = AuthSession(user_id=user.id, family_id=old.family_id, token_digest=digest_refresh_token(new_raw), expires_at=old.expires_at)
    db.add(replacement)
    db.flush()
    old.last_used_at = now
    old.revoked_at = now
    old.replaced_by_id = replacement.id
    db.commit()
    db.refresh(replacement)
    return user, new_raw, replacement


def _aware(value: datetime) -> datetime:
    return value if value.tzinfo else value.replace(tzinfo=timezone.utc)


def revoke_refresh(db: Session, raw: str) -> None:
    session = db.scalar(select(AuthSession).where(AuthSession.token_digest == digest_refresh_token(raw)).with_for_update())
    if session is not None:
        db.execute(update(AuthSession).where(AuthSession.family_id == session.family_id, AuthSession.revoked_at.is_(None)).values(revoked_at=datetime.now(timezone.utc)))
        db.commit()


def revoke_all(db: Session, user: User, *, increment_version: bool = True) -> None:
    db.execute(update(AuthSession).where(AuthSession.user_id == user.id, AuthSession.revoked_at.is_(None)).values(revoked_at=datetime.now(timezone.utc)))
    if increment_version:
        user.auth_version += 1
    db.commit()
    db.refresh(user)


def resolve_user(db: Session, token: str) -> User:
    claims = decode_access_token(token)
    user = db.get(User, str(claims["sub"]))
    if user is None or not user.is_active or user.auth_version != claims.get("ver"):
        raise AuthFailure("invalid authentication credentials")
    return user


def change_password(db: Session, user: User, current: str, new: str) -> None:
    valid, _ = verify_password(current, user.password_hash)
    if not valid:
        raise AuthFailure("current password is incorrect")
    user.password_hash = hash_password(new)
    revoke_all(db, user, increment_version=True)
