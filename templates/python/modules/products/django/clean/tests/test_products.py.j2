@pytest.mark.django_db
def test_product_with_category(api_client: APIClient) -> None:
    category = api_client.post(
        "/api/categories/",
        {"name": "Tools", "description": "Handy tools"},
        format="json",
    ).json()
    product = api_client.post(
        "/api/products/",
        {
            "name": "Hammer",
            "price": "12.00",
            "category_id": category["id"],
        },
        format="json",
    )
    assert product.status_code == 201
    assert product.json()["category_id"] == category["id"]

    listed = api_client.get("/api/products/", {"category_id": category["id"]})
    assert listed.status_code == 200
    assert all(
        item["category_id"] == category["id"]
        for item in listed.json()["results"]
    )
