"""Products HTTP presentation."""

from __future__ import annotations

from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime
from decimal import Decimal, InvalidOperation

from flask import Blueprint, jsonify, request
from pydantic import BaseModel, ConfigDict, Field, ValidationError
from sqlalchemy.orm import Session

from {{ package_name }}.application import products as use_cases
from {{ package_name }}.domain.product import Product
from {{ package_name }}.infrastructure.database import create_session
from {{ package_name }}.infrastructure.persistence.product import (
    ORDERING_CHOICES,
    SqlAlchemyProductRepository,
)
from {{ package_name }}.presentation.pagination import get_page_params

bp = Blueprint("products", __name__, url_prefix="/api/products")


class ProductCreate(BaseModel):
    name: str = Field(..., max_length=200)
    description: str | None = None
    price: Decimal = Field(..., max_digits=12, decimal_places=2)
    is_active: bool = True
{% if products_link_categories %}
    category_id: int | None = None
{% endif %}


class ProductUpdate(BaseModel):
    name: str | None = Field(None, max_length=200)
    description: str | None = None
    price: Decimal | None = Field(None, max_digits=12, decimal_places=2)
    is_active: bool | None = None
{% if products_link_categories %}
    category_id: int | None = None
{% endif %}


class ProductRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    name: str
    description: str | None
    price: Decimal
    is_active: bool
    created_at: datetime
    updated_at: datetime
{% if products_link_categories %}
    category_id: int | None
{% endif %}


@contextmanager
def _db() -> Iterator[Session]:
    gen = create_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def _repo(db: Session) -> SqlAlchemyProductRepository:
    return SqlAlchemyProductRepository(db)


def _optional_bool(name: str) -> bool | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    lowered = raw.lower()
    if lowered in ("true", "1", "yes"):
        return True
    if lowered in ("false", "0", "no"):
        return False
    return None


def _optional_decimal(name: str) -> Decimal | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    try:
        return Decimal(raw)
    except (InvalidOperation, ValueError):
        return None


@bp.post("")
def create_product():
    try:
        body = ProductCreate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        product = use_cases.create_product(
            _repo(db),
            Product(
                name=body.name,
                description=body.description,
                price=body.price,
                is_active=body.is_active,
{% if products_link_categories %}
                category_id=body.category_id,
{% endif %}
            ),
        )
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json")), 201


@bp.get("")
def list_products():
    params = get_page_params()
    ordering = request.args.get("ordering", "-created_at")
    if ordering not in ORDERING_CHOICES:
        return jsonify({"detail": f"Invalid ordering: {ordering}"}), 422
    is_active = _optional_bool("is_active")
    if request.args.get("is_active") is not None and is_active is None:
        return jsonify({"detail": "Invalid is_active"}), 422
    min_price = _optional_decimal("min_price")
    if request.args.get("min_price") is not None and min_price is None:
        return jsonify({"detail": "Invalid min_price"}), 422
    max_price = _optional_decimal("max_price")
    if request.args.get("max_price") is not None and max_price is None:
        return jsonify({"detail": "Invalid max_price"}), 422
{% if products_link_categories %}
    category_id_raw = request.args.get("category_id")
    category_id: int | None = None
    if category_id_raw is not None:
        try:
            category_id = int(category_id_raw)
        except ValueError:
            return jsonify({"detail": "Invalid category_id"}), 422
{% endif %}
    with _db() as db:
        items, total = use_cases.list_products(
            _repo(db),
            q=request.args.get("q"),
            is_active=is_active,
            min_price=min_price,
            max_price=max_price,
{% if products_link_categories %}
            category_id=category_id,
{% endif %}
            ordering=ordering,
            page=params.page,
            page_size=params.page_size,
        )
        return jsonify(
            {
                "items": [
                    ProductRead.model_validate(item).model_dump(mode="json")
                    for item in items
                ],
                "page": params.page,
                "page_size": params.page_size,
                "total": total,
            }
        )


@bp.get("/<int:product_id>")
def get_product(product_id: int):
    with _db() as db:
        product = use_cases.get_product(_repo(db), product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json"))


@bp.patch("/<int:product_id>")
def update_product(product_id: int):
    try:
        body = ProductUpdate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        repo = _repo(db)
        existing = use_cases.get_product(repo, product_id)
        if existing is None:
            return jsonify({"detail": "Not found"}), 404
        for key, value in body.model_dump(exclude_unset=True).items():
            setattr(existing, key, value)
        updated = use_cases.update_product(repo, existing)
        return jsonify(ProductRead.model_validate(updated).model_dump(mode="json"))


@bp.delete("/<int:product_id>")
def delete_product(product_id: int):
    with _db() as db:
        if not use_cases.delete_product(_repo(db), product_id):
            return jsonify({"detail": "Not found"}), 404
        return ("", 204)
