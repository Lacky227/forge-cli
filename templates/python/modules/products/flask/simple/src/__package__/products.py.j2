"""Products API: schemas, service helpers, and blueprint."""

from __future__ import annotations

from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime
from decimal import Decimal, InvalidOperation
from typing import Any

from flask import Blueprint, jsonify, request
from pydantic import BaseModel, ConfigDict, Field, ValidationError
from sqlalchemy import or_
from sqlalchemy.orm import Session

from {{ package_name }}.database import get_session
from {{ package_name }}.pagination import (
    get_page_params,
    paginate,
)
from {{ package_name }}.products_models import Product

bp = Blueprint("products", __name__, url_prefix="/api/products")

_ORDERING = {
    "name": Product.name.asc(),
    "-name": Product.name.desc(),
    "price": Product.price.asc(),
    "-price": Product.price.desc(),
    "created_at": Product.created_at.asc(),
    "-created_at": Product.created_at.desc(),
}


class ProductCreate(BaseModel):
    name: str = Field(..., max_length=200)
    description: str | None = None
    price: Decimal = Field(..., max_digits=12, decimal_places=2)
    is_active: bool = True
{% if products_link_categories %}
    category_id: int | None = None
{% endif %}


class ProductUpdate(BaseModel):
    name: str | None = Field(None, max_length=200)
    description: str | None = None
    price: Decimal | None = Field(None, max_digits=12, decimal_places=2)
    is_active: bool | None = None
{% if products_link_categories %}
    category_id: int | None = None
{% endif %}


class ProductRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    name: str
    description: str | None
    price: Decimal
    is_active: bool
    created_at: datetime
    updated_at: datetime
{% if products_link_categories %}
    category_id: int | None
{% endif %}


@contextmanager
def _db() -> Iterator[Session]:
    gen = get_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def _optional_bool(name: str) -> bool | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    lowered = raw.lower()
    if lowered in ("true", "1", "yes"):
        return True
    if lowered in ("false", "0", "no"):
        return False
    return None


def _optional_decimal(name: str) -> Decimal | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    try:
        return Decimal(raw)
    except (InvalidOperation, ValueError):
        return None


def create_product(db: Session, data: ProductCreate) -> Product:
    product = Product(**data.model_dump())
    db.add(product)
    db.commit()
    db.refresh(product)
    return product


def get_product(db: Session, product_id: int) -> Product | None:
    return db.get(Product, product_id)


def list_products(
    db: Session,
    *,
    q: str | None = None,
    is_active: bool | None = None,
    min_price: Decimal | None = None,
    max_price: Decimal | None = None,
{% if products_link_categories %}
    category_id: int | None = None,
{% endif %}
    ordering: str = "-created_at",
) -> Any:
    query = db.query(Product)
    if q:
        pattern = f"%{q}%"
        query = query.filter(
            or_(Product.name.ilike(pattern), Product.description.ilike(pattern))
        )
    if is_active is not None:
        query = query.filter(Product.is_active.is_(is_active))
    if min_price is not None:
        query = query.filter(Product.price >= min_price)
    if max_price is not None:
        query = query.filter(Product.price <= max_price)
{% if products_link_categories %}
    if category_id is not None:
        query = query.filter(Product.category_id == category_id)
{% endif %}
    query = query.order_by(_ORDERING.get(ordering, Product.created_at.desc()))
    return query


def update_product(
    db: Session, product: Product, data: ProductUpdate
) -> Product:
    for key, value in data.model_dump(exclude_unset=True).items():
        setattr(product, key, value)
    db.add(product)
    db.commit()
    db.refresh(product)
    return product


def delete_product(db: Session, product: Product) -> None:
    db.delete(product)
    db.commit()


@bp.post("")
def create_product_endpoint():
    try:
        body = ProductCreate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        product = create_product(db, body)
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json")), 201


@bp.get("")
def list_products_endpoint():
    params = get_page_params()
    ordering = request.args.get("ordering", "-created_at")
    if ordering not in _ORDERING:
        return jsonify({"detail": f"Invalid ordering: {ordering}"}), 422
    is_active = _optional_bool("is_active")
    if request.args.get("is_active") is not None and is_active is None:
        return jsonify({"detail": "Invalid is_active"}), 422
    min_price = _optional_decimal("min_price")
    if request.args.get("min_price") is not None and min_price is None:
        return jsonify({"detail": "Invalid min_price"}), 422
    max_price = _optional_decimal("max_price")
    if request.args.get("max_price") is not None and max_price is None:
        return jsonify({"detail": "Invalid max_price"}), 422
{% if products_link_categories %}
    category_id_raw = request.args.get("category_id")
    category_id: int | None = None
    if category_id_raw is not None:
        try:
            category_id = int(category_id_raw)
        except ValueError:
            return jsonify({"detail": "Invalid category_id"}), 422
{% endif %}
    with _db() as db:
        query = list_products(
            db,
            q=request.args.get("q"),
            is_active=is_active,
            min_price=min_price,
            max_price=max_price,
{% if products_link_categories %}
            category_id=category_id,
{% endif %}
            ordering=ordering,
        )
        result = paginate(query, params.page, params.page_size)
        return jsonify(
            {
                "items": [
                    ProductRead.model_validate(item).model_dump(mode="json")
                    for item in result["items"]
                ],
                "page": result["page"],
                "page_size": result["page_size"],
                "total": result["total"],
            }
        )


@bp.get("/<int:product_id>")
def get_product_endpoint(product_id: int):
    with _db() as db:
        product = get_product(db, product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json"))


@bp.patch("/<int:product_id>")
def update_product_endpoint(product_id: int):
    try:
        body = ProductUpdate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        product = get_product(db, product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        updated = update_product(db, product, body)
        return jsonify(ProductRead.model_validate(updated).model_dump(mode="json"))


@bp.delete("/<int:product_id>")
def delete_product_endpoint(product_id: int):
    with _db() as db:
        product = get_product(db, product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        delete_product(db, product)
        return ("", 204)
