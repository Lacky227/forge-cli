"""Products HTTP routes."""

from __future__ import annotations

from collections.abc import Iterator
from contextlib import contextmanager
from decimal import Decimal, InvalidOperation

from flask import Blueprint, jsonify, request
from pydantic import ValidationError
from sqlalchemy.orm import Session

from {{ package_name }}.api.pagination import (
    get_page_params,
    paginate,
)
from {{ package_name }}.core.database import get_session
from {{ package_name }}.repositories.product import ORDERING_CHOICES
from {{ package_name }}.schemas.product import ProductCreate, ProductRead, ProductUpdate
from {{ package_name }}.services.product import ProductService

bp = Blueprint("products", __name__, url_prefix="/api/products")


@contextmanager
def _db() -> Iterator[Session]:
    gen = get_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def _optional_bool(name: str) -> bool | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    lowered = raw.lower()
    if lowered in ("true", "1", "yes"):
        return True
    if lowered in ("false", "0", "no"):
        return False
    return None


def _optional_decimal(name: str) -> Decimal | None:
    raw = request.args.get(name)
    if raw is None:
        return None
    try:
        return Decimal(raw)
    except (InvalidOperation, ValueError):
        return None


@bp.post("")
def create_product():
    try:
        body = ProductCreate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        product = ProductService(db).create(body)
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json")), 201


@bp.get("")
def list_products():
    params = get_page_params()
    ordering = request.args.get("ordering", "-created_at")
    if ordering not in ORDERING_CHOICES:
        return jsonify({"detail": f"Invalid ordering: {ordering}"}), 422
    is_active = _optional_bool("is_active")
    if request.args.get("is_active") is not None and is_active is None:
        return jsonify({"detail": "Invalid is_active"}), 422
    min_price = _optional_decimal("min_price")
    if request.args.get("min_price") is not None and min_price is None:
        return jsonify({"detail": "Invalid min_price"}), 422
    max_price = _optional_decimal("max_price")
    if request.args.get("max_price") is not None and max_price is None:
        return jsonify({"detail": "Invalid max_price"}), 422
{% if products_link_categories %}
    category_id_raw = request.args.get("category_id")
    category_id: int | None = None
    if category_id_raw is not None:
        try:
            category_id = int(category_id_raw)
        except ValueError:
            return jsonify({"detail": "Invalid category_id"}), 422
{% endif %}
    with _db() as db:
        query = ProductService(db).list_query(
            q=request.args.get("q"),
            is_active=is_active,
            min_price=min_price,
            max_price=max_price,
{% if products_link_categories %}
            category_id=category_id,
{% endif %}
            ordering=ordering,
        )
        result = paginate(query, params.page, params.page_size)
        return jsonify(
            {
                "items": [
                    ProductRead.model_validate(item).model_dump(mode="json")
                    for item in result["items"]
                ],
                "page": result["page"],
                "page_size": result["page_size"],
                "total": result["total"],
            }
        )


@bp.get("/<int:product_id>")
def get_product(product_id: int):
    with _db() as db:
        product = ProductService(db).get(product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(ProductRead.model_validate(product).model_dump(mode="json"))


@bp.patch("/<int:product_id>")
def update_product(product_id: int):
    try:
        body = ProductUpdate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        service = ProductService(db)
        product = service.get(product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        updated = service.update(product, body)
        return jsonify(ProductRead.model_validate(updated).model_dump(mode="json"))


@bp.delete("/<int:product_id>")
def delete_product(product_id: int):
    with _db() as db:
        service = ProductService(db)
        product = service.get(product_id)
        if product is None:
            return jsonify({"detail": "Not found"}), 404
        service.delete(product)
        return ("", 204)
