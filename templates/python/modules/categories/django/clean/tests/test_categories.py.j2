"""Categories API tests."""

from __future__ import annotations

import pytest
from rest_framework.test import APIClient


@pytest.mark.django_db
def test_create_and_get_category(api_client: APIClient) -> None:
    response = api_client.post(
        "/api/categories/",
        {"name": "Electronics", "description": "Gadgets"},
        format="json",
    )
    assert response.status_code == 201
    body = response.json()
    assert body["name"] == "Electronics"
    assert body["slug"] == "electronics"

    detail = api_client.get(f"/api/categories/{body['id']}/")
    assert detail.status_code == 200
    assert detail.json()["slug"] == "electronics"


@pytest.mark.django_db
def test_create_category_with_explicit_slug(api_client: APIClient) -> None:
    response = api_client.post(
        "/api/categories/",
        {"name": "Home Goods", "slug": "home", "description": None},
        format="json",
    )
    assert response.status_code == 201
    assert response.json()["slug"] == "home"


@pytest.mark.django_db
def test_list_update_delete_category(api_client: APIClient) -> None:
    created = api_client.post(
        "/api/categories/",
        {"name": "Books"},
        format="json",
    ).json()

    listed = api_client.get("/api/categories/")
    assert listed.status_code == 200
    payload = listed.json()
    assert payload["count"] >= 1
    assert any(item["id"] == created["id"] for item in payload["results"])

    updated = api_client.patch(
        f"/api/categories/{created['id']}/",
        {"name": "Books & Magazines", "slug": "books-magazines"},
        format="json",
    )
    assert updated.status_code == 200
    assert updated.json()["slug"] == "books-magazines"

    deleted = api_client.delete(f"/api/categories/{created['id']}/")
    assert deleted.status_code == 204
    assert api_client.get(f"/api/categories/{created['id']}/").status_code == 404


@pytest.mark.django_db
def test_category_not_found_and_validation(api_client: APIClient) -> None:
    assert api_client.get("/api/categories/99999/").status_code == 404
    assert (
        api_client.patch(
            "/api/categories/99999/", {"name": "x"}, format="json"
        ).status_code
        == 404
    )
    assert api_client.delete("/api/categories/99999/").status_code == 404

    invalid = api_client.post("/api/categories/", {}, format="json")
    assert invalid.status_code == 400


@pytest.mark.django_db
def test_category_pagination_and_filters(api_client: APIClient) -> None:
    api_client.post("/api/categories/", {"name": "Alpha Cat"}, format="json")
    api_client.post(
        "/api/categories/",
        {"name": "Beta Cat", "description": "second"},
        format="json",
    )

    listed = api_client.get("/api/categories/")
    assert listed.status_code == 200
    assert listed.json()["count"] >= 2
    assert len(listed.json()["results"]) <= 20

    filtered = api_client.get("/api/categories/", {"q": "Alpha"})
    assert filtered.status_code == 200
    assert all("Alpha" in item["name"] for item in filtered.json()["results"])

    ordered = api_client.get("/api/categories/", {"ordering": "-name"})
    assert ordered.status_code == 200
    names = [item["name"] for item in ordered.json()["results"]]
    assert names == sorted(names, reverse=True)


@pytest.mark.django_db
def test_duplicate_slug_rejected(api_client: APIClient) -> None:
    api_client.post(
        "/api/categories/",
        {"name": "One", "slug": "shared"},
        format="json",
    )
    duplicate = api_client.post(
        "/api/categories/",
        {"name": "Two", "slug": "shared"},
        format="json",
    )
    assert duplicate.status_code == 400
