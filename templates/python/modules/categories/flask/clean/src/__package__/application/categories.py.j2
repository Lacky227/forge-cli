"""Category use cases."""

from __future__ import annotations

import re
import unicodedata

from {{ package_name }}.application.category_ports import (
    CategoryRepository,
)
from {{ package_name }}.domain.category import Category


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^\w\s-]", "", ascii_text.lower())
    slug = re.sub(r"[-\s]+", "-", slug).strip("-")
    return (slug or "category")[:220]


class SlugConflictError(Exception):
    """Raised when a category slug is already taken."""


def create_category(repo: CategoryRepository, category: Category) -> Category:
    if not category.slug:
        category.slug = slugify(category.name)
    if repo.get_by_slug(category.slug) is not None:
        raise SlugConflictError(category.slug)
    return repo.create(category)


def get_category(repo: CategoryRepository, category_id: int) -> Category | None:
    return repo.get(category_id)


def list_categories(
    repo: CategoryRepository,
    *,
    q: str | None = None,
    ordering: str = "name",
    page: int = 1,
    page_size: int = 20,
) -> tuple[list[Category], int]:
    return repo.list(q=q, ordering=ordering, page=page, page_size=page_size)


def update_category(repo: CategoryRepository, category: Category) -> Category:
    existing = repo.get_by_slug(category.slug)
    if existing is not None and existing.id != category.id:
        raise SlugConflictError(category.slug)
    return repo.update(category)


def delete_category(repo: CategoryRepository, category_id: int) -> bool:
    return repo.delete(category_id)
