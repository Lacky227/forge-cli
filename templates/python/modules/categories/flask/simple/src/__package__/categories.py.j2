"""Categories API: schemas, service helpers, and blueprint."""

from __future__ import annotations

import re
import unicodedata
from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime
from typing import Any

from flask import Blueprint, jsonify, request
from pydantic import BaseModel, ConfigDict, Field, ValidationError
from sqlalchemy import or_
from sqlalchemy.orm import Session

from {{ package_name }}.categories_models import Category
from {{ package_name }}.database import get_session
from {{ package_name }}.pagination import (
    get_page_params,
    paginate,
)

bp = Blueprint("categories", __name__, url_prefix="/api/categories")

_ORDERING = {
    "name": Category.name.asc(),
    "-name": Category.name.desc(),
    "created_at": Category.created_at.asc(),
    "-created_at": Category.created_at.desc(),
}


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^\w\s-]", "", ascii_text.lower())
    slug = re.sub(r"[-\s]+", "-", slug).strip("-")
    return (slug or "category")[:220]


class CategoryCreate(BaseModel):
    name: str = Field(..., max_length=200)
    slug: str | None = Field(None, max_length=220)
    description: str | None = None


class CategoryUpdate(BaseModel):
    name: str | None = Field(None, max_length=200)
    slug: str | None = Field(None, max_length=220)
    description: str | None = None


class CategoryRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    name: str
    slug: str
    description: str | None
    created_at: datetime
    updated_at: datetime


@contextmanager
def _db() -> Iterator[Session]:
    gen = get_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def create_category(db: Session, data: CategoryCreate) -> Category:
    payload = data.model_dump()
    if not payload.get("slug"):
        payload["slug"] = slugify(payload["name"])
    existing = db.query(Category).filter(Category.slug == payload["slug"]).first()
    if existing is not None:
        raise ValueError("slug already exists")
    category = Category(**payload)
    db.add(category)
    db.commit()
    db.refresh(category)
    return category


def get_category(db: Session, category_id: int) -> Category | None:
    return db.get(Category, category_id)


def list_categories(
    db: Session,
    *,
    q: str | None = None,
    ordering: str = "name",
) -> Any:
    query = db.query(Category)
    if q:
        pattern = f"%{q}%"
        query = query.filter(
            or_(Category.name.ilike(pattern), Category.description.ilike(pattern))
        )
    query = query.order_by(_ORDERING.get(ordering, Category.name.asc()))
    return query


def update_category(
    db: Session, category: Category, data: CategoryUpdate
) -> Category:
    payload = data.model_dump(exclude_unset=True)
    if "slug" in payload and payload["slug"] is None:
        del payload["slug"]
    if "name" in payload and "slug" not in payload and not category.slug:
        payload["slug"] = slugify(payload["name"])
    if "slug" in payload:
        existing = (
            db.query(Category)
            .filter(Category.slug == payload["slug"], Category.id != category.id)
            .first()
        )
        if existing is not None:
            raise ValueError("slug already exists")
    for key, value in payload.items():
        setattr(category, key, value)
    db.add(category)
    db.commit()
    db.refresh(category)
    return category


def delete_category(db: Session, category: Category) -> None:
    db.delete(category)
    db.commit()


@bp.post("")
def create_category_endpoint():
    try:
        body = CategoryCreate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        try:
            category = create_category(db, body)
        except ValueError as exc:
            return jsonify({"detail": str(exc)}), 422
        return (
            jsonify(CategoryRead.model_validate(category).model_dump(mode="json")),
            201,
        )


@bp.get("")
def list_categories_endpoint():
    params = get_page_params()
    ordering = request.args.get("ordering", "name")
    if ordering not in _ORDERING:
        return jsonify({"detail": f"Invalid ordering: {ordering}"}), 422
    with _db() as db:
        query = list_categories(db, q=request.args.get("q"), ordering=ordering)
        result = paginate(query, params.page, params.page_size)
        return jsonify(
            {
                "items": [
                    CategoryRead.model_validate(item).model_dump(mode="json")
                    for item in result["items"]
                ],
                "page": result["page"],
                "page_size": result["page_size"],
                "total": result["total"],
            }
        )


@bp.get("/<int:category_id>")
def get_category_endpoint(category_id: int):
    with _db() as db:
        category = get_category(db, category_id)
        if category is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(CategoryRead.model_validate(category).model_dump(mode="json"))


@bp.patch("/<int:category_id>")
def update_category_endpoint(category_id: int):
    try:
        body = CategoryUpdate.model_validate(request.get_json(silent=True) or {})
    except ValidationError as exc:
        return jsonify({"detail": exc.errors()}), 422
    with _db() as db:
        category = get_category(db, category_id)
        if category is None:
            return jsonify({"detail": "Not found"}), 404
        try:
            updated = update_category(db, category, body)
        except ValueError as exc:
            return jsonify({"detail": str(exc)}), 422
        return jsonify(CategoryRead.model_validate(updated).model_dump(mode="json"))


@bp.delete("/<int:category_id>")
def delete_category_endpoint(category_id: int):
    with _db() as db:
        category = get_category(db, category_id)
        if category is None:
            return jsonify({"detail": "Not found"}), 404
        delete_category(db, category)
        return ("", 204)
