@pytest.mark.django_db
def test_upload_list_get_download_delete(api_client: APIClient) -> None:
    upload = SimpleUploadedFile("hello.txt", b"hello world", content_type="text/plain")
    response = api_client.post("/api/files/", {"upload": upload}, format="multipart")
    assert response.status_code == 201
    body = response.json()
    assert body["filename"] == "hello.txt"
    assert body["size"] == 11

    listed = api_client.get("/api/files/")
    assert listed.status_code == 200
    assert listed.json()["count"] >= 1

    detail = api_client.get(f"/api/files/{body['id']}/")
    assert detail.status_code == 200

    content = api_client.get(f"/api/files/{body['id']}/content/")
    assert content.status_code == 200
    assert content.content == b"hello world"

    assert api_client.delete(f"/api/files/{body['id']}/").status_code == 204


@pytest.mark.django_db
def test_empty_upload_rejected(api_client: APIClient) -> None:
    upload = SimpleUploadedFile("empty.txt", b"", content_type="text/plain")
    response = api_client.post("/api/files/", {"upload": upload}, format="multipart")
    assert response.status_code == 422
