def test_upload_list_get_download_delete(client) -> None:
    response = client.post(
        "/api/files",
        data={"upload": (BytesIO(b"hello world"), "hello.txt")},
        content_type="multipart/form-data",
    )
    assert response.status_code == 201
    body = response.get_json()
    assert body["filename"] == "hello.txt"

    content = client.get(f"/api/files/{body['id']}/content")
    assert content.status_code == 200
    assert content.data == b"hello world"

    assert client.delete(f"/api/files/{body['id']}").status_code == 204


def test_empty_upload_rejected(client) -> None:
    response = client.post(
        "/api/files",
        data={"upload": (BytesIO(b""), "empty.txt")},
        content_type="multipart/form-data",
    )
    assert response.status_code == 422
