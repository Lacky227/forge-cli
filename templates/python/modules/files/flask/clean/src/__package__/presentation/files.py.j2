bp = Blueprint("files", __name__, url_prefix="/api/files")


class FileRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    filename: str
    content_type: str | None
    size: int
    storage_key: str
    created_at: datetime


@contextmanager
def _db() -> Iterator[Session]:
    gen = get_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def _repo(db: Session) -> SqlAlchemyFileRepository:
    return SqlAlchemyFileRepository(db)


def get_storage():
{% if is_storage_local %}
    return LocalStorage(Config.STORAGE_LOCAL_ROOT)
{% endif %}
{% if is_storage_s3 %}
    return S3Storage(
        bucket=Config.S3_BUCKET,
        endpoint_url=Config.S3_ENDPOINT_URL,
        access_key=Config.S3_ACCESS_KEY,
        secret_key=Config.S3_SECRET_KEY,
        region=Config.S3_REGION,
        create_bucket=Config.S3_CREATE_BUCKET,
    )
{% endif %}


@bp.post("")
def upload_file():
    upload = request.files.get("upload") or request.files.get("file")
    if upload is None:
        return jsonify({"detail": "Missing upload"}), 422
    with _db() as db:
        try:
            file = use_cases.upload_file(
                _repo(db),
                get_storage(),
                filename=upload.filename or "",
                data=upload.read(),
                content_type=upload.mimetype,
                max_bytes=Config.UPLOAD_MAX_BYTES,
                make_key=new_storage_key,
                safe_name=safe_filename,
            )
        except ValueError as exc:
            detail = str(exc)
            code = 413 if "UPLOAD_MAX_BYTES" in detail else 422
            return jsonify({"detail": detail}), code
        return jsonify(FileRead.model_validate(file).model_dump(mode="json")), 201


@bp.get("")
def list_files():
    params = get_page_params()
    with _db() as db:
        items, total = use_cases.list_files(
            _repo(db), page=params.page, page_size=params.page_size
        )
        return jsonify(
            {
                "items": [
                    FileRead.model_validate(item).model_dump(mode="json")
                    for item in items
                ],
                "page": params.page,
                "page_size": params.page_size,
                "total": total,
            }
        )


@bp.get("/<int:file_id>")
def get_file(file_id: int):
    with _db() as db:
        file = use_cases.get_file(_repo(db), file_id)
        if file is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(FileRead.model_validate(file).model_dump(mode="json"))


@bp.get("/<int:file_id>/content")
def download_file(file_id: int):
    with _db() as db:
        try:
            result = use_cases.download_file(_repo(db), get_storage(), file_id)
        except (FileNotFoundError, OSError):
            return jsonify({"detail": "Object missing"}), 404
        if result is None:
            return jsonify({"detail": "Not found"}), 404
        file, data = result
        return Response(
            data,
            mimetype=file.content_type or "application/octet-stream",
            headers={
                "Content-Disposition": f'attachment; filename="{file.filename}"',
            },
        )


@bp.delete("/<int:file_id>")
def delete_file(file_id: int):
    with _db() as db:
        if not use_cases.delete_file(_repo(db), get_storage(), file_id):
            return jsonify({"detail": "Not found"}), 404
        return ("", 204)
