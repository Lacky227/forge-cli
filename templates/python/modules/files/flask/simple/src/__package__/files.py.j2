"""Files API: upload, list, metadata, download, delete."""

from __future__ import annotations

from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime

from flask import Blueprint, Response, jsonify, request
from pydantic import BaseModel, ConfigDict
from sqlalchemy.orm import Session

from {{ package_name }}.config import Config
from {{ package_name }}.database import get_session
from {{ package_name }}.files_models import File
from {{ package_name }}.files_storage import (
{% if is_storage_local %}
    LocalStorage,
{% endif %}
{% if is_storage_s3 %}
    S3Storage,
{% endif %}
    new_storage_key,
    safe_filename,
)
from {{ package_name }}.pagination import get_page_params, paginate

bp = Blueprint("files", __name__, url_prefix="/api/files")


class FileRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    filename: str
    content_type: str | None
    size: int
    storage_key: str
    created_at: datetime


@contextmanager
def _db() -> Iterator[Session]:
    gen = get_session()
    session = next(gen)
    try:
        yield session
    finally:
        gen.close()


def get_storage():
{% if is_storage_local %}
    return LocalStorage(Config.STORAGE_LOCAL_ROOT)
{% endif %}
{% if is_storage_s3 %}
    return S3Storage(
        bucket=Config.S3_BUCKET,
        endpoint_url=Config.S3_ENDPOINT_URL,
        access_key=Config.S3_ACCESS_KEY,
        secret_key=Config.S3_SECRET_KEY,
        region=Config.S3_REGION,
        create_bucket=Config.S3_CREATE_BUCKET,
    )
{% endif %}


@bp.post("")
def upload_file():
    upload = request.files.get("upload") or request.files.get("file")
    if upload is None:
        return jsonify({"detail": "Missing upload"}), 422
    try:
        filename = safe_filename(upload.filename or "")
    except ValueError as exc:
        return jsonify({"detail": str(exc)}), 422
    data = upload.read()
    if not data:
        return jsonify({"detail": "Empty upload"}), 422
    if len(data) > Config.UPLOAD_MAX_BYTES:
        return jsonify({"detail": "File exceeds UPLOAD_MAX_BYTES"}), 413

    key = new_storage_key(filename)
    get_storage().save(key, data, content_type=upload.mimetype)
    with _db() as db:
        row = File(
            filename=filename,
            content_type=upload.mimetype,
            size=len(data),
            storage_key=key,
        )
        db.add(row)
        db.commit()
        db.refresh(row)
        return jsonify(FileRead.model_validate(row).model_dump(mode="json")), 201


@bp.get("")
def list_files():
    params = get_page_params()
    with _db() as db:
        query = db.query(File).order_by(File.created_at.desc())
        result = paginate(query, params.page, params.page_size)
        return jsonify(
            {
                "items": [
                    FileRead.model_validate(item).model_dump(mode="json")
                    for item in result["items"]
                ],
                "page": result["page"],
                "page_size": result["page_size"],
                "total": result["total"],
            }
        )


@bp.get("/<int:file_id>")
def get_file(file_id: int):
    with _db() as db:
        row = db.get(File, file_id)
        if row is None:
            return jsonify({"detail": "Not found"}), 404
        return jsonify(FileRead.model_validate(row).model_dump(mode="json"))


@bp.get("/<int:file_id>/content")
def download_file(file_id: int):
    with _db() as db:
        row = db.get(File, file_id)
        if row is None:
            return jsonify({"detail": "Not found"}), 404
        try:
            data = get_storage().load(row.storage_key)
        except (FileNotFoundError, OSError):
            return jsonify({"detail": "Object missing"}), 404
        return Response(
            data,
            mimetype=row.content_type or "application/octet-stream",
            headers={
                "Content-Disposition": f'attachment; filename="{row.filename}"',
            },
        )


@bp.delete("/<int:file_id>")
def delete_file(file_id: int):
    with _db() as db:
        row = db.get(File, file_id)
        if row is None:
            return jsonify({"detail": "Not found"}), 404
        try:
            get_storage().delete(row.storage_key)
        except Exception:
            pass
        db.delete(row)
        db.commit()
        return ("", 204)
