"""Files module tests (local storage; no live S3)."""

from __future__ import annotations

from pathlib import Path

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.config import settings


@pytest.fixture()
def storage_root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
    root = tmp_path / "storage"
    root.mkdir()
    monkeypatch.setattr(settings, "storage_local_root", str(root))
    monkeypatch.setattr(settings, "upload_max_bytes", 1024)
    return root


def test_upload_list_get_download_delete(
    client: TestClient, storage_root: Path
) -> None:
    response = client.post(
        "/files",
        files={"file": ("hello.txt", b"hello world", "text/plain")},
    )
    assert response.status_code == 201, response.text
    body = response.json()
    assert body["filename"] == "hello.txt"
    assert body["size"] == 11
    assert ".." not in body["storage_key"]
    file_id = body["id"]

    listed = client.get("/files")
    assert listed.status_code == 200
    assert listed.json()["total"] >= 1

    meta = client.get(f"/files/{file_id}")
    assert meta.status_code == 200
    assert meta.json()["id"] == file_id

    content = client.get(f"/files/{file_id}/content")
    assert content.status_code == 200
    assert content.content == b"hello world"

    deleted = client.delete(f"/files/{file_id}")
    assert deleted.status_code == 204
    assert client.get(f"/files/{file_id}").status_code == 404


def test_reject_empty_and_large(client: TestClient, storage_root: Path) -> None:
    empty = client.post(
        "/files", files={"file": ("empty.txt", b"", "text/plain")}
    )
    assert empty.status_code == 400
    big = client.post(
        "/files",
        files={"file": ("big.bin", b"x" * 2048, "application/octet-stream")},
    )
    assert big.status_code == 413
