def test_upload_list_get_download_delete(client: TestClient) -> None:
    response = client.post(
        "/files",
        files={"file": ("hello.txt", b"hello world", "text/plain")},
    )
    assert response.status_code == 201
    body = response.json()
    assert body["filename"] == "hello.txt"
    assert body["size"] == 11

    listed = client.get("/files")
    assert listed.status_code == 200
    assert any(item["id"] == body["id"] for item in listed.json()["items"])

    content = client.get(f"/files/{body['id']}/content")
    assert content.status_code == 200
    assert content.content == b"hello world"

    assert client.delete(f"/files/{body['id']}").status_code == 204
    assert client.get(f"/files/{body['id']}").status_code == 404


def test_empty_upload_rejected(client: TestClient) -> None:
    assert client.post(
        "/files",
        files={"file": ("empty.txt", b"", "text/plain")},
    ).status_code == 422
