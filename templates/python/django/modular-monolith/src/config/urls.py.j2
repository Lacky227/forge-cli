from django.contrib import admin
from django.urls import include, path

urlpatterns = [
    path("admin/", admin.site.urls),
{% if rest_framework %}
    path("api/", include("{{ primary_app }}.urls")),
{% for app in django_apps|sort(attribute='module_id') %}
    path("api/", include("{{ app.urls_module }}")),
{% endfor %}
{% endif %}
]
