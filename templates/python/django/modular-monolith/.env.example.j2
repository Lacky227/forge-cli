DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
{% if is_postgresql %}
POSTGRES_DB={{ package_name }}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
{% endif %}
{% if is_sqlite %}
# SQLite database file is created at ./db.sqlite3 by default.
{% endif %}
{% if is_mongodb %}
MONGODB_URL={{ mongodb_url_example }}
MONGODB_DATABASE={{ mongodb_database_example }}
{% endif %}
{% if is_redis %}
REDIS_URL={{ redis_url_example }}
{% endif %}
