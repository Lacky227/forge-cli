[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Generated by Forge"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
{% for dep in runtime_dependencies %}
    "{{ dep }}",
{% endfor %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/config", "src/{{ primary_app }}"{% for app in django_apps %}{% if app.app_config %}, "src/{{ app.app_config }}"{% endif %}{% endfor %}]

[dependency-groups]
dev = [
{% for dep in dev_dependencies %}
    "{{ dep }}",
{% endfor %}
]

{% if testing %}
[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings"
pythonpath = ["src"]
testpaths = ["tests"]
{% endif %}

{% if linting %}
[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
{% if has_authentication %}

[tool.ruff.lint.per-file-ignores]
"**/*auth*.py" = ["E501", "I001", "UP017"]
"**/identity/**/*.py" = ["E501", "I001", "UP017"]
"tests/test_authentication.py" = ["E501", "I001"]
{% endif %}
{% endif %}
